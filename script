/* =========================
   GET ELEMENTS
========================= */

const screens =
  document.querySelectorAll(".screen");

const startBtn =
  document.getElementById("startBtn");

const yesBtn =
  document.getElementById("yesBtn");

const noBtn =
  document.getElementById("noBtn");

const buttonArea =
  document.getElementById("buttonArea");

const tease =
  document.getElementById("tease");

const continueBtn =
  document.getElementById("continueBtn");

const restartBtn =
  document.getElementById("restartBtn");


/* =========================
   STORE HER CHOICES
========================= */

const choices = {

  type: null,

  day: null

};


/* =========================
   CHANGE PAGE
========================= */

function showScreen(id) {

  screens.forEach(screen => {

    screen.classList.remove("active");

  });


  document
    .getElementById(id)
    .classList.add("active");


  window.scrollTo({

    top: 0,

    behavior: "smooth"

  });

}


/* =========================
   START BUTTON
========================= */

startBtn.addEventListener(
  "click",
  () => {

    showScreen("question");

  }
);


/* =========================
   NO BUTTON
========================= */

const teaseMessages = [

  "Hmm… that button seems a little shy. 👀",

  "Nice try 😂",

  "I don't think that's the button you want.",

  "Are you REALLY sure? 🥺",

  "The universe says… try again.",

  "Okay okay, I'll pretend you didn't click that."

];


let teaseIndex = 0;


/* Move the NO button */

function moveNoButton() {

  const area =
    buttonArea.getBoundingClientRect();

  const btn =
    noBtn.getBoundingClientRect();


  const maxX =
    Math.max(
      0,
      area.width - btn.width
    );


  const maxY =
    Math.max(
      0,
      area.height - btn.height
    );


  const x =
    Math.random() * maxX;


  const y =
    Math.random() * maxY;


  noBtn.style.left =
    `${x}px`;


  noBtn.style.top =
    `${y}px`;


  noBtn.style.right =
    "auto";


  noBtn.style.transform =
    "none";


  tease.textContent =
    teaseMessages[
      teaseIndex %
      teaseMessages.length
    ];


  teaseIndex++;

}


/* Desktop */

noBtn.addEventListener(
  "mouseenter",
  moveNoButton
);


/* Mouse / pointer */

noBtn.addEventListener(
  "pointerdown",
  (event) => {

    event.preventDefault();

    moveNoButton();

  }
);


/* Mobile */

noBtn.addEventListener(
  "touchstart",
  (event) => {

    event.preventDefault();

    moveNoButton();

  },
  {
    passive: false
  }
);


/* =========================
   YES BUTTON
========================= */

yesBtn.addEventListener(
  "click",
  () => {

    showScreen("options");

  }
);


/* =========================
   DATE OPTIONS
========================= */

document
  .querySelectorAll(".choices")
  .forEach(group => {

    const groupName =
      group.dataset.group;


    group
      .querySelectorAll(".choice")
      .forEach(button => {

        button.addEventListener(
          "click",
          () => {

            /* Remove previous selection */

            group
              .querySelectorAll(".choice")
              .forEach(b => {

                b.classList.remove(
                  "selected"
                );

              });


            /* Select current */

            button.classList.add(
              "selected"
            );


            /* Save choice */

            choices[groupName] =
              button.dataset.value;


            /* Enable continue */

            continueBtn.disabled =
              !(
                choices.type &&
                choices.day
              );

          }
        );

      });

  });


/* =========================
   CONTINUE
========================= */

continueBtn.addEventListener(
  "click",
  () => {

    if (
      !choices.type ||
      !choices.day
    ) {

      return;

    }


    document
      .getElementById("summaryType")
      .textContent =
      choices.type;


    document
      .getElementById("summaryDay")
      .textContent =
      choices.day;


    showScreen("final");


    celebrate();

  }
);


/* =========================
   RESTART
========================= */

restartBtn.addEventListener(
  "click",
  () => {

    choices.type = null;

    choices.day = null;


    document
      .querySelectorAll(".choice")
      .forEach(button => {

        button.classList.remove(
          "selected"
        );

      });

// CHANGE THIS TO YOUR WHATSAPP NUMBER (include country code, without + or spaces)
// Example for Oman (+968): "968XXXXXXXX"
const myWhatsAppNumber = "96899817245";
    continueBtn.disabled =
      true;


    tease.textContent =
      "";


    teaseIndex = 0;


    /* Reset NO button */

    noBtn.style.left = "";

    noBtn.style.top = "";

    noBtn.style.right = "";

    noBtn.style.transform = "";


    showScreen("intro");

  }
);


/* =========================
   HEART ANIMATION
========================= */

function createHeart(
  fromCelebration = false
) {

  const heart =
    document.createElement("span");


  heart.className =
    "floating-heart";


  heart.textContent =
    Math.random() > 0.25
      ? "♥"
      : "♡";


  heart.style.left =
    `${Math.random() * 100}%`;


  heart.style.fontSize =
    `${
      10 +
      Math.random() *
      (fromCelebration ? 18 : 10)
    }px`;


  heart.style.animationDuration =
    `${
      4 +
      Math.random() * 5
    }s`;


  document
    .querySelector(".hearts")
    .appendChild(heart);


  setTimeout(
    () => heart.remove(),
    10000
  );

}


/* =========================
   CELEBRATION
========================= */

function celebrate() {

  for (
    let i = 0;
    i < 18;
    i++
  ) {

    setTimeout(
      () => createHeart(true),
      i * 80
    );

  }

}


/* Background hearts */

setInterval(
  () => createHeart(false),
  1200
);